{
  "version": 2,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/history",
      "destination": "/api/index?__route__=/history"
    },
    {
      "source": "/check",
      "destination": "/api/index?__route__=/check"
    },
    {
      "source": "/health",
      "destination": "/api/index?__route__=/health"
    },
    {
      "source": "/generate",
      "destination": "/api/index?__route__=/generate"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?__route__=/$1"
    }
  ]
}
