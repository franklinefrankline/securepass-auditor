{
  "version": 2,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/history",
      "destination": "/api/history"
    },
    {
      "source": "/check",
      "destination": "/api/check"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/generate",
      "destination": "/api/generate"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
